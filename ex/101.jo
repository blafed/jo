//main.scene
Scene {
    objects {
        {name 'player', transform {pos {0,0,0}}, components {Player{attack 15, defense 20}}}
        {name 'enemy1', transform{pos{1,2,2}} components {Enemy{attack 15, aggressive 20}}}
        {name 'enemy2', components {Enemy{attack 15, aggressive 20}}}
    }
}


main() {
    jovy.run()
    s jovy.res('main.scene')
    jovy.run_scene(s)
}