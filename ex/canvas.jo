canvas.{
    me Canvas

    set_width(me, width float) void
    set_height(me, height float) void
    resize(me, w float, h float) void
    screen(me, vis bool) void

    moveto(me, x float, y float) void
    lineto(me, x float, y float) void
    rect(me, x float, y float, width float, height float) void
    circle(me, x float, y float, radius float) void
    line(me, x1 float, y1 float, x2 float, y2 float) void
    text(me, x float, y float, text str) void
    save(me) void
    restore(me) void
    translate(me, x float, y float) void
    scale(me, x float, y float) void
}